<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<ServerGarbageCollection>true</ServerGarbageCollection>
	</PropertyGroup>

	<!--
		The Benchmark\ subdirectory hosts its own sibling project (Benchmark\BlackBox.Benchmark.csproj).
		Without this exclusion, default SDK globbing would sweep its source *and* its bin\/obj\ output
		(including generated AssemblyInfo.cs) into this project too, breaking the build and hijacking
		this project's entry point.
	-->
	<ItemGroup>
		<Compile Remove="Benchmark\**" />
		<EmbeddedResource Remove="Benchmark\**" />
		<None Remove="Benchmark\**" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Solve.Evaluation\Solve.Evaluation.csproj" />
		<ProjectReference Include="..\..\Solve.Experiment\Solve.Experiment.csproj" />
		<ProjectReference Include="..\..\Solve\Solve.csproj" />
	</ItemGroup>

</Project>